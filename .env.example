# Copy to .env and fill in. NEVER commit .env.

# --- Database (local compose) ---
POSTGRES_USER=meoi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meoi

# --- LLM (needed from M1) ---
# Vân creates her own key at console.anthropic.com with a monthly spend limit.
ANTHROPIC_API_KEY=
# Model name is never hard-coded; re-run the 7 tier evals whenever it changes.
ANTHROPIC_MODEL=

# --- Auth ---
# Any long random string (32+ chars). Signs login sessions.
JWT_SECRET=
